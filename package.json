    "@semantic-release/exec": "^8.0.0-beta.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^13.0.0-beta.1",
    "@semantic-release/npm": "^14.0.0-beta.3",
    "@semantic-release/release-notes-generator": "^15.0.0-beta.4",
    "@tsconfig/node26": "^26.0.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.11",
    "commitlint": "^21.2.4",
    "conventional-changelog-conventionalcommits": "^10.4.1",
