{
  "name": "groupbox-avalonia",
  "description": "dev-environment utilities",
  "scripts": {
    "prepare": "husky && dotnet tool restore",
    "format": "dotnet format && yarn xstyler",
    "lint": "eslint --cache",
    "release": "yarn semantic-release",
    "test": "dotnet test",
    "update-readme": "yarn node ./tools/updateReadMe.mjs",
    "xstyler": "yarn node -- ./tools/formatXamlFiles.mjs --ignore"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
