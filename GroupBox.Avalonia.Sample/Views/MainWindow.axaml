<Window x:Class="GroupBox.Avalonia.Sample.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avalonian GroupBox Sample"
        x:DataType="view:MainWindow" xmlns:view="using:GroupBox.Avalonia.Sample.Views"
        Background="{DynamicResource TranslucentBackground}"
        SizeToContent="WidthAndHeight" TransparencyLevelHint="AcrylicBlur">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TranslucentBackground"
                           Opacity="0.5"
                           Color="#ffffff" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TranslucentBackground"
                           Opacity="0.5"
                           Color="#000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <FluentTheme />
  </Window.Styles>

  <Grid Margin="10"
        ColumnDefinitions="* *" RowDefinitions="*">
    <ComboBox Name="ThemeVariantComboBox"
              Grid.RowSpan="2" Grid.Column="0"
              Width="100"
              SelectedIndex="0" SelectionChanged="ThemeVariantComboBox_OnSelectionChanged" />

    <StackPanel Grid.Column="1" Margin="10">
      <CheckBox Name="FluentWindowButton"
                IsCheckedChanged="FluentWindowButton_OnChanged">
        Show FluentWindow
      </CheckBox>

      <CheckBox Name="SimpleWindowButton"
                IsCheckedChanged="SimpleWindowButton_OnChanged">
        Show SimpleWindow
      </CheckBox>
    </StackPanel>
  </Grid>
</Window>