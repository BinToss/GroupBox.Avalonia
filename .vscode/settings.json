{
  "dotnet.defaultSolution": "GroupBox.Avalonia.slnx",
  "files.associations": {
    "tsconfig*.json": "jsonc"
  },
  "xml.codeLens.enabled": true,
  "xml.format.maxLineWidth": 100,
  "xml.format.preserveAttributeLineBreaks": false,
  "xml.format.splitAttributes": "alignWithFirstAttr",
  "[AXAML]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnType": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnType": false
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "filewatcher.commands": [
    {
      "vscodeTask": [
        "workbench.action.tasks.runTask",
        "npm: xstyler"
      ],
      "event": "onFileChange",
      "match": ".*/.axaml"
    }
  ],
  "csharp.debug.symbolOptions.searchMicrosoftSymbolServer": true,
  "csharp.debug.symbolOptions.searchNuGetOrgSymbolServer": true,
  "js/ts.tsdk.path": ".yarn/sdks/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "eslint.nodePath": ".yarn/sdks",
  "axaml.selectedSolution": "GroupBox.Avalonia.slnx",
  "cSpell.words": [
    "axaml",
    "conv",
    "groupboxavalonia",
    "Headered",
    "slnx",
    "snupkg"
  ],
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  }
}
