{
    "extends": "./.config/tsconfig.base.json",
    "compilerOptions": {
        "outDir": ".tsout",
        "erasableSyntaxOnly": true
    },
    "include": [
        "./*.cts",
        "./*.mts",
        "./*.ts"
    ],
    "exclude": [
        "node_modules",
        "GroupBox.Avalonia",
        "GroupBox.Avalonia.Sample",
        "publish",
        "artifacts"
    ],
    "files": [
        "commitlint.config.ts",
        "eslint.config.ts",
        ".releaserc.ts",
        "./tools/formatXamlFiles.mjs",
        "./tools/updateReadMe.mjs"
    ]
}
